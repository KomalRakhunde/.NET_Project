@{
    ViewData["Title"] = "Admin Control Panel";
    var recent = ViewBag.RecentBookings as List<TourManagement_MVC.Models.Booking> ?? new List<TourManagement_MVC.Models.Booking>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-bold mb-1">
                <i class="bi bi-shield-lock-fill me-1"></i> Control Panel
            </span>
            <h1 class="fw-bold mb-0">Admin Dashboard</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="AddTour" class="btn btn-primary fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Add Tour Package
            </a>
            <a asp-action="Logout" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-right me-1"></i> Sign Out
            </a>
        </div>
    </div>

    <!-- Stats row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Total Tours</span>
                        <h2 class="fw-bold mb-0 text-primary">@ViewBag.TotalTours</h2>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-map display-6"></i>
                    </div>
                </div>
                <hr />
                <a asp-action="ManageTours" class="text-primary fw-semibold small text-decoration-none">
                    Manage Tours <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Total Bookings</span>
                        <h2 class="fw-bold mb-0 text-success">@ViewBag.TotalBookings</h2>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-calendar2-check display-6"></i>
                    </div>
                </div>
                <hr />
                <a asp-action="AllBookings" class="text-success fw-semibold small text-decoration-none">
                    View All Bookings <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Registered Users</span>
                        <h2 class="fw-bold mb-0 text-info">@ViewBag.TotalUsers</h2>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle">
                        <i class="bi bi-people display-6"></i>
                    </div>
                </div>
                <hr />
                <a asp-action="ManageUsers" class="text-info fw-semibold small text-decoration-none">
                    Manage Users <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Actions and Recent Bookings -->
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Actions</h5>
                <div class="d-grid gap-2">
                    <a asp-action="AddTour" class="btn btn-outline-primary py-2 text-start">
                        <i class="bi bi-plus-square me-2"></i> Add New Tour
                    </a>
                    <a asp-action="ManageTours" class="btn btn-outline-secondary py-2 text-start">
                        <i class="bi bi-table me-2"></i> Manage Tour Catalog (CRUD)
                    </a>
                    <a asp-action="AllBookings" class="btn btn-outline-success py-2 text-start">
                        <i class="bi bi-card-checklist me-2"></i> View Customer Reservations
                    </a>
                    <a asp-action="ManageUsers" class="btn btn-outline-info py-2 text-start">
                        <i class="bi bi-people-fill me-2"></i> Customer Account List
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Recent Booking Requests</h5>
                    <a asp-action="AllBookings" class="small fw-semibold text-primary">View All</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Tour</th>
                                <th>Destination</th>
                                <th>Traveler</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in recent)
                            {
                                <tr>
                                    <td class="fw-semibold">#@item.BookingId</td>
                                    <td class="fw-bold">@item.TourName</td>
                                    <td>@item.Place</td>
                                    <td>@item.FirstName</td>
                                    <td><span class="badge bg-success">@item.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
