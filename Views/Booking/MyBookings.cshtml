@model List<TourManagement_MVC.Models.Booking>
@{
    ViewData["Title"] = "My Tour Bookings";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-1">My Bookings</h1>
            <p class="text-muted mb-0">Overview of your current and past tour reservations.</p>
        </div>
        <a asp-controller="Tour" asp-action="Index" class="btn btn-primary fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Book New Tour
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm text-center py-5 rounded-4 bg-white">
            <div class="card-body">
                <i class="bi bi-ticket-perforated display-1 text-muted mb-3 d-block"></i>
                <h4 class="fw-bold">You haven't made any bookings yet!</h4>
                <p class="text-muted mb-3">Discover breathtaking vacation packages and book your next trip today.</p>
                <a asp-controller="Tour" asp-action="Index" class="btn btn-primary px-4">Browse Tours</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Booking ID</th>
                            <th>Tour Package</th>
                            <th>Destination</th>
                            <th>Traveler Name</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">#BK-@booking.BookingId.ToString("D4")</td>
                                <td>
                                    <span class="fw-bold">@booking.TourName</span>
                                </td>
                                <td><i class="bi bi-geo-alt-fill text-danger me-1"></i> @booking.Place</td>
                                <td>@booking.FirstName</td>
                                <td>
                                    @if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Confirmed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill">
                                            @booking.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (booking.Status == "Confirmed")
                                    {
                                        <form asp-action="Cancel" asp-route-id="@booking.BookingId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Cancelled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
