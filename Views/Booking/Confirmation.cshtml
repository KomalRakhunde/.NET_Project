@model TourManagement_MVC.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed!";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
                <div class="mb-3 text-success">
                    <i class="bi bi-patch-check-fill display-1"></i>
                </div>
                <h2 class="fw-bold mb-2">Booking Confirmed!</h2>
                <p class="text-muted mb-4">Your travel package reservation has been registered successfully.</p>

                <div class="card bg-light border-0 p-3 text-start mb-4 rounded-3">
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted">Booking Reference:</span>
                        <strong class="text-primary">#BK-@Model.BookingId.ToString("D5")</strong>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted">Package Name:</span>
                        <strong>@Model.TourName</strong>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted">Destination:</span>
                        <strong>@Model.Place</strong>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted">Lead Traveler:</span>
                        <strong>@Model.FirstName</strong>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted">Email:</span>
                        <strong>@Model.Email</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Status:</span>
                        <span class="badge bg-success">@Model.Status</span>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="MyBookings" class="btn btn-primary fw-semibold px-4">
                        <i class="bi bi-ticket-perforated me-1"></i> View My Bookings
                    </a>
                    <a asp-controller="Tour" asp-action="Index" class="btn btn-outline-secondary px-4">
                        Explore More
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
