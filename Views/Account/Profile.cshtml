@model TourManagement_MVC.Models.User
@{
    ViewData["Title"] = "User Profile";
    var bookings = ViewBag.UserBookings as List<TourManagement_MVC.Models.Booking> ?? new List<TourManagement_MVC.Models.Booking>();
}

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white text-center">
                <div class="mx-auto mb-3 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                    <i class="bi bi-person-fill"></i>
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-3">@Model.Email</p>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill mb-4">
                    <i class="bi bi-shield-check me-1"></i> Active Traveler Account
                </span>

                <div class="d-grid gap-2">
                    <a asp-controller="Tour" asp-action="Index" class="btn btn-primary fw-semibold">
                        <i class="bi bi-compass me-1"></i> Browse Tours
                    </a>
                    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary">
                        <i class="bi bi-ticket-perforated me-1"></i> My Bookings (@bookings.Count)
                    </a>
                    <a asp-action="Logout" class="btn btn-outline-danger">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-person-lines-fill text-primary me-2"></i>Account Details</h5>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">First Name</span>
                        <strong class="fs-6">@Model.FirstName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Last Name</span>
                        <strong class="fs-6">@Model.LastName</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Gender</span>
                        <strong class="fs-6">@Model.Gender</strong>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Date of Birth</span>
                        <strong class="fs-6">@Model.DateOfBirth.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="col-12">
                        <span class="text-muted small d-block">Address</span>
                        <strong class="fs-6">@Model.Street, @Model.City, @Model.State</strong>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Recent Booking History</h5>
                    <a asp-controller="Booking" asp-action="MyBookings" class="small fw-semibold text-primary">View All</a>
                </div>

                @if (bookings.Count == 0)
                {
                    <p class="text-muted small mb-0">No booking activity yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in bookings.Take(3))
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="mb-0 fw-bold">@item.TourName</h6>
                                    <small class="text-muted"><i class="bi bi-geo-alt"></i> @item.Place</small>
                                </div>
                                <span class="badge bg-success">@item.Status</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
