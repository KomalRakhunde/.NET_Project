@model List<TourManagement_MVC.Models.Tour>
@{
    ViewData["Title"] = "Discover Incredible Journeys";
}

<div class="bg-dark text-white py-5 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                    <i class="bi bi-stars me-1"></i> Premium Tour Experience
                </span>
                <h1 class="display-4 fw-extrabold mb-3 text-white">Find Your Next Great Adventure</h1>
                <p class="lead text-slate-300 mb-4" style="color: #cbd5e1;">
                    Explore curated holiday packages, scenic hill stations, tropical beaches, and rich cultural heritage across the country.
                </p>

                <form asp-controller="Tour" asp-action="Index" method="get" class="card p-3 shadow-lg border-0 bg-white">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control border-0" placeholder="Destination or tour name...">
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input type="text" name="place" class="form-control border-0" placeholder="Place / City...">
                            </div>
                        </div>
                        <div class="col-12 col-md-3">
                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                Search Tours
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <div class="card border-0 shadow-lg overflow-hidden rounded-4" style="transform: rotate(2deg);">
                    <img src="~/images/tours/Landscape.jpg" class="img-fluid" alt="Adventure Travel" style="height: 320px; object-fit: cover;">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-3 text-center mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-3 h-100 bg-white">
                <i class="bi bi-map-fill text-primary display-6 mb-2"></i>
                <h3 class="fw-bold mb-1">@ViewBag.TotalTours+</h3>
                <p class="text-muted mb-0">Tour Packages Available</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-3 h-100 bg-white">
                <i class="bi bi-people-fill text-info display-6 mb-2"></i>
                <h3 class="fw-bold mb-1">@ViewBag.TotalUsers+</h3>
                <p class="text-muted mb-0">Registered Travelers</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-3 h-100 bg-white">
                <i class="bi bi-calendar-check-fill text-success display-6 mb-2"></i>
                <h3 class="fw-bold mb-1">@ViewBag.TotalBookings+</h3>
                <p class="text-muted mb-0">Bookings Completed</p>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Featured Tour Packages</h2>
            <p class="text-muted mb-0">Handpicked holiday destinations for your next unforgettable getaway.</p>
        </div>
        <a asp-controller="Tour" asp-action="Index" class="btn btn-outline-primary fw-semibold">
            View All Tours <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var tour in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="tour-card h-100 d-flex flex-column">
                    <div class="position-relative">
                        <img src="~/images/tours/@tour.Pic" class="tour-card-img" alt="@tour.TourName" onerror="this.src='/images/tours/TravelImage.jpg'">
                        <span class="badge bg-primary position-absolute top-0 end-0 m-3 px-3 py-2 shadow-sm rounded-pill">
                            <i class="bi bi-clock me-1"></i> @tour.Days Days
                        </span>
                        <span class="badge bg-dark bg-opacity-75 position-absolute bottom-0 start-0 m-3 px-3 py-2 rounded-pill">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> @tour.Place
                        </span>
                    </div>
                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold mb-2">@tour.TourName</h5>
                        <p class="text-muted small mb-3 flex-grow-1">@tour.TourInfo</p>
                        
                        <div class="border-top pt-3 mt-auto d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small d-block">Starting from</span>
                                <span class="fw-extrabold text-primary fs-5">₹@tour.Price.ToString("N0")</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-controller="Tour" asp-action="Details" asp-route-id="@tour.TourId" class="btn btn-outline-secondary btn-sm">
                                    Details
                                </a>
                                <a asp-controller="Booking" asp-action="Create" asp-route-tourId="@tour.TourId" class="btn btn-primary btn-sm fw-semibold">
                                    Book Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
